# syntax=docker/dockerfile:1.7

# scriba
#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends guile; \
    zypper clean --all

COPY src/scriba ./src/scriba

RUN set -eu; \
    site="/usr/share/guile/site/3.0"; \
    install -d "$site/scriba"; \
    cp -r "src/scriba/." "$site/scriba/"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="scriba" \
      org.opencontainers.image.description="Structured logging framework for Guile Scheme" \
      org.opencontainers.image.url="https://codeberg.org/jjba23/scriba" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile \
        ca-certificates \
        guile-json; \
    zypper clean --all

COPY --from=builder /usr/share/guile/site/3.0/scriba /usr/share/guile/site/3.0/scriba

ENTRYPOINT ["guile"]
