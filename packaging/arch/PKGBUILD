# Maintainer: Josep Bigorra <jjbigorra@gmail.com>
pkgname=scriba
pkgver=0.5.2
pkgrel=1
pkgdesc="Structured logging framework for Guile Scheme"
arch=('any')
url="https://github.com/jjba23/scriba"
license=('MIT')

depends=(
  'guile'
  'guile-json'
)

makedepends=(
  'guile'
  'pkgconf'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('95f6b282663c858bf9a797eb02012db410d1b5ccb87ae35bdad8fabaed1070ad')

# Guile looks for byte-compiled modules under the site-ccache directory,
# which differs between distributions, so ask Guile's pkg-config file
# instead of hard-coding a path.
_site_dir() {
  pkg-config --variable=sitedir guile-3.0 2>/dev/null \
    || echo /usr/share/guile/site/3.0
}

_compiled_dir() {
  pkg-config --variable=siteccachedir guile-3.0 2>/dev/null \
    || echo /usr/lib/guile/3.0/site-ccache
}

build() {
  cd "$srcdir/$pkgname-$pkgver"

  # Byte-compile every module, mirroring the source tree under a staging
  # directory that package() copies into the compiled site directory.
  rm -rf "$srcdir/ccache"
  mkdir -p "$srcdir/ccache/scriba"

  while IFS= read -r scm_file; do
    rel_path="${scm_file#src/}"
    go_file="$srcdir/ccache/${rel_path%.scm}.go"
    mkdir -p "$(dirname "$go_file")"
    guild compile -L src -o "$go_file" "$scm_file"
  done < <(find src/scriba -name '*.scm')
}

# Upstream's suites need Veritas, which Arch does not package, so there is no
# check(): the sources are byte-compiled above and that is the whole build.

package() {
  cd "$srcdir/$pkgname-$pkgver"


  site_dir="$(_site_dir)"
  install -d "$pkgdir${site_dir}/scriba"
  cp -r src/scriba/. "$pkgdir${site_dir}/scriba/"

  ccache_dir="$(_compiled_dir)"
  install -d "$pkgdir${ccache_dir}/scriba"
  cp -r "$srcdir/ccache/scriba/." "$pkgdir${ccache_dir}/scriba/"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
  install -Dm644 docs/*.org -t "$pkgdir/usr/share/doc/$pkgname/docs/"
}
